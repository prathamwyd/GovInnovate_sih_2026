DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/govpilot
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=25
PORT=5000
FLASK_DEBUG=false

# Frontend API configuration. Leave this as /api for local Vite development;
# Vite forwards it to the Flask server on 127.0.0.1:5000.
VITE_API_BASE_URL=/api
# For a separately deployed API, use its public origin instead, for example:
# VITE_API_BASE_URL=https://api.example.gov.in/api
